---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

const principles = [
  {
    n: '01',
    title: 'Get to the truth',
    body: 'Nothing matters more than getting to the truth. The market does not care about your feelings or your ego. We must deliver what the market wants, not what we want. In discussions and arguments, focus on getting to the truth, not on winning the argument.',
    credit: 'Harvard University',
  },
  {
    n: '02',
    title: 'Build your craft',
    body: "The Company's craft is building intelligent systems. We are dedicating our careers to this craft. Engineering, design, product, sales, marketing — these are part of the craft you are building as a profession and calling.",
    credit: 'Jiro Ono',
  },
  {
    n: '03',
    title: 'Be intellectually honest',
    body: 'Do not pretend to know what you do not know. Admit it when you are wrong. Do not be defensive. Ask for help if you need. Being intellectually honest requires you to have the courage to be wrong and vulnerable.',
    credit: 'Harvard University',
  },
  {
    n: '04',
    title: 'Write well to think well',
    body: 'The best way to think better is to write better. We have a heavy writing culture, where all important meetings and thoughts are documented.',
    credit: 'Jeff Bezos',
  },
  {
    n: '05',
    title: 'Decide in writing',
    body: 'All important decisions (especially Type-1, one-way-door decisions) are written down and heavily scrutinized in a decision document prior to the decision being made.',
    credit: 'Jeff Bezos',
  },
  {
    n: '06',
    title: 'Measure twice, cut once',
    body: 'Think twice before saying or doing something. A significant amount of time can be saved if one thinks through all the parameters of an action prior to doing or speaking. We want to be measured and in control.',
    credit: 'Harvard University',
  },
  {
    n: '07',
    title: 'Always be moving',
    body: 'A company that does not have a default stance and movement even in the face of uncertainty is dying. Calculated movement gives more information. Stasis means death.',
    credit: 'Reid Hoffman, Paul Graham, Jeff Bezos',
  },
  {
    n: '08',
    title: 'Have too much ambition',
    body: 'Ambitious startups are easier to build. We can attract more capital, attract better people, and stand for something much bigger than ourselves. When in doubt, have more ambition, not less.',
    credit: 'Sam Altman',
  },
  {
    n: '09',
    title: 'Speed AND quality',
    body: 'Being fast is incredibly important in a startup. A false dichotomy is that speed requires sacrifice in quality. We must achieve both. The way to do this is to reduce requirements down to their absolute core.',
    credit: 'Patrick Collison, Sam Altman',
  },
  {
    n: '10',
    title: 'Reduce surface area',
    body: 'Most product success happens because of focus, not because of the number of features. Having a smaller surface area allows us to be more nimble and execute faster.',
    credit: 'Elon Musk',
  },
  {
    n: '11',
    title: 'Cut out the middleman',
    body: 'Talk and work directly with the people doing the work. We do not believe in middle managers whose primary job is to manage. Direct communication enables speed and clarity.',
    credit: 'Elon Musk',
  },
  {
    n: '12',
    title: 'Founder mode',
    body: 'The Company is built around the unique strengths of our founders. This allows high speed and quality of output. Our culture of truth-seeking and intellectual honesty allows us to operate with high trust when acting quickly.',
    credit: 'Brian Chesky',
  },
  {
    n: '13',
    title: 'EV > TV > MeV',
    body: "Solve for the company value (enterprise value, EV) over your team's value (TV), over your own value. Always do the right thing for the company as a whole, not just for your team.",
    credit: 'Brian Halligan',
  },
];
---

<BaseLayout
  title="How we think — ACE"
  description="Thirteen working principles. How we make decisions, run engagements, and hold each other accountable."
>
  <Nav />

  <main id="main">
    <header class="phi-hero">
      <div class="container-page">
        <p class="eyebrow">Philosophy</p>
        <h1>How <em>we think.</em></h1>
        <p class="lead">
          Thirteen working principles. How we make decisions, run engagements,
          and hold each other accountable. Read top-to-bottom, or jump to the
          one that matters right now.
        </p>
      </div>
    </header>

    <section class="phi-toc-section">
      <div class="container-page">
        <span class="phi-toc-label">Index</span>
        <ol class="phi-toc">
          {
            principles.map((p) => (
              <li>
                <a href={`#p-${p.n}`}>
                  <span class="phi-toc-num">{p.n}</span>
                  <span class="phi-toc-title">{p.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="phi-list-section">
      <div class="container-page">
        <ol class="phi-list">
          {
            principles.map((p) => (
              <li id={`p-${p.n}`}>
                <div class="p-num" aria-hidden="true">
                  {p.n}
                </div>
                <div class="p-body">
                  <h2>{p.title}</h2>
                  <p class="p-text">{p.body}</p>
                  <p class="p-credit">h/t {p.credit}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="phi-close">
      <div class="container-page">
        <div class="phi-close-inner">
          <p class="lead">
            These aren&apos;t aspirations. They&apos;re how we work.
          </p>
          <div class="phi-close-actions">
            <Button href="/#book">
              Work with us <span>→</span>
            </Button>
            <Button href="/notes" variant="ghost">Read the notes</Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero ----------------------------------------------------------- */
  .phi-hero {
    padding-block: 120px 64px;
  }

  .phi-hero .eyebrow {
    margin-bottom: 24px;
  }

  .phi-hero h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-foreground-dim);
  }

  .phi-hero .lead {
    margin-top: 32px;
    max-width: 660px;
  }

  /* Index / TOC ---------------------------------------------------- */
  .phi-toc-section {
    padding-block: 32px 64px;
    border-bottom: 1px solid var(--color-border);
  }

  .phi-toc-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    display: block;
    margin-bottom: 24px;
  }

  .phi-toc {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 48px;
    row-gap: 0;
  }

  .phi-toc li {
    border-top: 1px solid var(--color-border);
  }

  .phi-toc li:nth-child(2) {
    border-top: 1px solid var(--color-border);
  }

  .phi-toc a {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    align-items: baseline;
    padding-block: 14px;
    text-decoration: none;
    color: var(--color-foreground-soft);
    transition: color 0.2s;
  }

  .phi-toc a:hover {
    color: var(--color-foreground);
  }

  .phi-toc-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
  }

  .phi-toc-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.3;
  }

  /* List ----------------------------------------------------------- */
  .phi-list-section {
    padding-block: 0 80px;
  }

  .phi-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .phi-list li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 48px;
    padding-block: 64px;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 96px;
  }

  .p-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 72px;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--color-foreground);
  }

  .p-body {
    max-width: 64ch;
  }

  .p-body h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .p-text {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-foreground-soft);
  }

  .p-credit {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    margin-top: 24px;
  }

  /* Close ---------------------------------------------------------- */
  .phi-close {
    padding-block: 96px 32px;
  }

  .phi-close-inner {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .phi-close .lead {
    margin: 0 auto 40px;
  }

  .phi-close-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Responsive ----------------------------------------------------- */
  @media (max-width: 760px) {
    .phi-hero {
      padding-block: 64px 40px;
    }

    .phi-toc {
      grid-template-columns: 1fr;
    }

    .phi-toc li:nth-child(2) {
      border-top: none;
    }

    .phi-list li {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-block: 48px;
    }

    .p-num {
      font-size: 48px;
    }

    .phi-close {
      padding-block: 64px 16px;
    }
  }
</style>
