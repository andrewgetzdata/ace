---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`${note.data.title} — ACE`}
  description={note.data.description}
>
  <Nav />

  <main id="main" class="note-page">
    <article class="note">
      <div class="container-page note-inner">
        <header class="note-head">
          <p class="eyebrow">
            <a href={`${base}/notes`}>Notes</a>
            <span class="note-head-sep" aria-hidden="true">·</span>
            <time datetime={note.data.pubDate.toISOString()}>
              {fmtDate(note.data.pubDate)}
            </time>
          </p>
          <h1>{note.data.title}</h1>
          {note.data.description && (
            <p class="lead note-lead">{note.data.description}</p>
          )}
        </header>

        <div class="note-divider" aria-hidden="true">
          <span></span>
          <svg width="14" height="14" viewBox="0 0 64 64" fill="none">
            <path
              d="M32 4 C32 4, 8 26, 8 42 C8 51, 14 56, 22 56 C27 56, 31 53, 32 49 C33 53, 37 56, 42 56 C50 56, 56 51, 56 42 C56 26, 32 4, 32 4 Z M24 60 L40 60 L36 50 L28 50 Z"
              fill="currentColor"
            />
          </svg>
          <span></span>
        </div>

        <div class="note-body">
          <Content />
        </div>

        <footer class="note-foot">
          <div class="note-foot-inner">
            <span class="eyebrow">Read another</span>
            <Button href={`${base}/notes`} variant="ghost">All notes →</Button>
          </div>
        </footer>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .note-page {
    padding-block: 80px 32px;
  }

  .note-inner {
    max-width: 760px;
  }

  .note-head .eyebrow {
    margin-bottom: 32px;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    color: var(--color-foreground-dim);
  }

  .note-head .eyebrow a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .note-head .eyebrow a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .note-head-sep {
    color: var(--color-foreground-muted);
  }

  .note-head h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 5.5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 32px;
  }

  .note-lead {
    margin-top: 0;
    color: var(--color-foreground-dim);
  }

  .note-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-block: 56px;
  }

  .note-divider span {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    max-width: 200px;
  }

  .note-divider svg {
    color: var(--color-foreground);
    flex-shrink: 0;
  }

  .note-body {
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.65;
    color: var(--color-foreground-soft);
  }

  .note-body :global(p) {
    margin: 0 0 24px;
  }

  .note-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 56px 0 16px;
    color: var(--color-foreground);
  }

  .note-body :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    margin: 40px 0 12px;
    color: var(--color-foreground);
  }

  .note-body :global(a) {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .note-body :global(strong) {
    font-weight: 700;
    color: var(--color-foreground);
  }

  .note-body :global(em) {
    font-style: italic;
  }

  .note-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 56px 0;
  }

  .note-body :global(blockquote) {
    border-left: 2px solid var(--color-foreground);
    padding-left: 24px;
    margin: 32px 0;
    color: var(--color-foreground);
    font-style: italic;
  }

  .note-body :global(ul),
  .note-body :global(ol) {
    margin: 0 0 24px;
    padding-left: 24px;
  }

  .note-body :global(li) {
    margin-bottom: 8px;
  }

  .note-foot {
    margin-top: 96px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .note-foot-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  @media (max-width: 640px) {
    .note-page {
      padding-block: 40px 16px;
    }
    .note-divider {
      margin-block: 40px;
    }
    .note-body {
      font-size: 17px;
    }
  }
</style>
