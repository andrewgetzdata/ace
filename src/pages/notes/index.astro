---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<BaseLayout
  title="Notes — ACE"
  description="Working notes from the practice. Operator-first thinking on AI, judgment, and what the deck doesn't tell you."
>
  <Nav />

  <main id="main">
    <header class="notes-hero">
      <div class="container-page">
        <p class="eyebrow">Notes</p>
        <h1>Working notes from <em>the practice.</em></h1>
        <p class="lead">
          What we&apos;re thinking about, what we&apos;re seeing in the field,
          and the questions we&apos;re asking inside our engagements.
        </p>
      </div>
    </header>

    <section class="notes-list-section">
      <div class="container-page">
        {
          notes.length === 0 ? (
            <p class="empty">No notes published yet.</p>
          ) : (
            <ol class="notes-list">
              {notes.map((n) => (
                <li class="notes-row">
                  <a href={`/notes/${n.id}`} class="notes-row-link">
                    <div class="notes-row-meta">
                      <time datetime={n.data.pubDate.toISOString()}>
                        {fmtDate(n.data.pubDate)}
                      </time>
                      {n.data.tags?.length > 0 && (
                        <span class="notes-row-tags">
                          {n.data.tags.join(' · ')}
                        </span>
                      )}
                    </div>
                    <h2>{n.data.title}</h2>
                    {n.data.description && (
                      <p class="notes-row-desc">{n.data.description}</p>
                    )}
                    <span class="notes-row-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .notes-hero {
    padding-block: 120px 64px;
  }

  .notes-hero .eyebrow {
    margin-bottom: 24px;
  }

  .notes-hero h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-foreground-dim);
  }

  .notes-hero .lead {
    margin-top: 32px;
    max-width: 620px;
  }

  .notes-list-section {
    padding-block: 32px 120px;
  }

  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .notes-row {
    border-top: 1px solid var(--color-border);
  }

  .notes-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .notes-row-link {
    display: block;
    position: relative;
    padding: 56px 64px 56px 0;
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.3s ease;
  }

  .notes-row-link:hover {
    padding-left: 16px;
  }

  .notes-row-meta {
    display: flex;
    gap: 16px;
    align-items: baseline;
    margin-bottom: 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .notes-row-meta time {
    color: var(--color-foreground-dim);
  }

  .notes-row-meta .notes-row-tags::before {
    content: '·';
    margin-right: 16px;
    color: var(--color-foreground-muted);
  }

  .notes-row h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 0 0 16px;
    max-width: 22ch;
    transition: text-decoration-color 0.2s;
  }

  .notes-row-link:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .notes-row-desc {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-foreground-soft);
    max-width: 60ch;
    margin: 0;
  }

  .notes-row-arrow {
    position: absolute;
    right: 0;
    top: 56px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 28px;
    line-height: 1;
    color: var(--color-foreground-muted);
    transition:
      color 0.2s,
      transform 0.3s ease;
  }

  .notes-row-link:hover .notes-row-arrow {
    color: var(--color-foreground);
    transform: translateX(8px);
  }

  .empty {
    color: var(--color-foreground-dim);
    font-size: 17px;
  }

  @media (max-width: 760px) {
    .notes-hero {
      padding-block: 64px 32px;
    }

    .notes-row-link {
      padding: 40px 40px 40px 0;
    }

    .notes-row-link:hover {
      padding-left: 0;
    }

    .notes-row-arrow {
      top: 40px;
      font-size: 22px;
    }

    .notes-row-meta {
      margin-bottom: 14px;
    }

    .notes-row h2 {
      max-width: none;
    }
  }
</style>
