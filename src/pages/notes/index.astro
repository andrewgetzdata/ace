---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<BaseLayout
  title="Notes — ACE"
  description="Working notes from the practice. Operator-first thinking on AI, judgment, and what the deck doesn't tell you."
>
  <Nav />

  <main id="main">
    <header class="notes-hero">
      <div class="container-page">
        <p class="eyebrow">Notes</p>
        <h1>Working notes from <em>the practice.</em></h1>
        <p class="lead">
          What we&apos;re thinking about, what we&apos;re seeing in the field,
          and the questions we&apos;re asking inside our engagements.
        </p>
      </div>
    </header>

    <section class="notes-list-section">
      <div class="container-page">
        {
          notes.length === 0 ? (
            <p class="empty">No notes published yet.</p>
          ) : (
            <ol class="notes-list">
              {notes.map((n) => (
                <li class="notes-row">
                  <a href={`/notes/${n.id}`} class="notes-row-link">
                    <time datetime={n.data.pubDate.toISOString()}>
                      {fmtDate(n.data.pubDate)}
                    </time>
                    <h2>{n.data.title}</h2>
                    {n.data.description && (
                      <p class="notes-row-desc">{n.data.description}</p>
                    )}
                    <span class="notes-row-cta">
                      Read note <span aria-hidden="true">→</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .notes-hero {
    padding-block: 120px 64px;
  }

  .notes-hero .eyebrow {
    margin-bottom: 24px;
  }

  .notes-hero h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-foreground-dim);
  }

  .notes-hero .lead {
    margin-top: 32px;
    max-width: 620px;
  }

  .notes-list-section {
    padding-block: 32px 120px;
  }

  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .notes-row {
    border-bottom: 1px solid var(--color-border);
  }

  .notes-row-link {
    display: grid;
    grid-template-columns: 140px 1fr 140px;
    gap: 32px;
    align-items: baseline;
    padding-block: 32px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }

  .notes-row-link:hover {
    background: var(--color-surface);
  }

  .notes-row-link time {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-dim);
  }

  .notes-row h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }

  .notes-row-desc {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-foreground-soft);
    max-width: 56ch;
  }

  .notes-row-cta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-dim);
    text-align: right;
    transition: color 0.2s;
  }

  .notes-row-link:hover .notes-row-cta {
    color: var(--color-foreground);
  }

  .empty {
    color: var(--color-foreground-dim);
    font-size: 17px;
  }

  @media (max-width: 760px) {
    .notes-row-link {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-block: 24px;
    }
    .notes-row-cta {
      text-align: left;
    }
    .notes-hero {
      padding-block: 64px 32px;
    }
  }
</style>
