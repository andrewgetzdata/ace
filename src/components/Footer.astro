---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-page footer-row">
    <div class="footer-brand">
      <Logo variant="full" />
      <p class="footer-tagline">Judgment over tooling.</p>
    </div>
    <div class="footer-cols">
      <div class="footer-col">
        <span class="footer-label">Site</span>
        <a href="/#thesis">Thesis</a>
        <a href="/#how">How we plug in</a>
        <a href="/#tiers">Tiers</a>
        <a href="/#who">Who it's for</a>
        <a href="/#about">About</a>
        <a href="/notes">Notes</a>
      </div>
      <div class="footer-col">
        <span class="footer-label">Contact</span>
        <a href="mailto:hello@ace.example">hello@ace.example</a>
        <a href="/#book">Book an intro</a>
      </div>
      <div class="footer-col">
        <span class="footer-label">Office</span>
        <span class="footer-text">Remote, US‑based.</span>
        <span class="footer-text">Operator‑led companies, $5–250M.</span>
      </div>
    </div>
  </div>
  <div class="container-page footer-base">
    <span>© {year} ACE Advisory</span>
    <span class="footer-base-mark" aria-hidden="true">♠</span>
    <span>AI Coaching &amp; Execution</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding-top: 80px;
    padding-bottom: 32px;
    margin-top: 80px;
  }

  .footer-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    padding-bottom: 64px;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 22px;
    color: var(--color-foreground-dim);
    margin-top: 16px;
    max-width: 280px;
    line-height: 1.4;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    margin-bottom: 4px;
  }

  .footer-col a {
    color: var(--color-foreground-soft);
    text-decoration: none;
    font-size: 15px;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--color-foreground);
  }

  .footer-text {
    font-size: 15px;
    color: var(--color-foreground-dim);
    line-height: 1.5;
  }

  .footer-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 32px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .footer-base-mark {
    font-size: 14px;
    color: var(--color-foreground);
  }

  @media (max-width: 760px) {
    .footer-row {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .footer-base {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
