---
interface Props {
  id?: string;
  eyebrow?: string;
  number?: string;
  class?: string;
}

const { id, eyebrow, number, class: className = '' } = Astro.props;
---

<section id={id} class:list={['section', className]}>
  <div class="container-page">
    {
      eyebrow && (
        <div class="section-label">
          {number && <span class="section-num">{number}</span>}
          <span>{eyebrow}</span>
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: 120px;
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-num {
    color: var(--color-foreground-muted);
  }

  @media (max-width: 640px) {
    .section {
      padding-block: 80px;
    }
  }
</style>
